# Required: OpenRouter API key
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Required ONLY if the model cohort includes a Vercel-only model
# (e.g. meta/muse-spark-1.1). Separate billing from OpenRouter — the
# OpenRouter key does not authenticate against the Vercel AI Gateway.
# Get one at https://vercel.com/ai-gateway  (alias: AI_GATEWAY_API_KEY)
# VERCEL_AI_GATEWAY_KEY=...

# Optional: override judge models
# JUDGE_MODEL=openai/gpt-5.4:online
# SPECIFICITY_JUDGE_MODEL=anthropic/claude-sonnet-4.6

# Optional: cap parallel model calls during generation (default 4)
# GENERATE_CONCURRENCY=4

# Optional: cap parallel signal-eval calls per model run (default 4)
# EVAL_CONCURRENCY=4
